import pandas as pd

# Sample raw dataset
data = {
    "Name ": ["Ravi", "Sita", "Ravi", "Kiran", "Anu", "Rahul"],
    "Gender": ["Male", "female", "Male", " MALE ", "Female", None],
    "Country": ["India", "india", "India", "INDIA", "India", "India"],
    "Age": [20, 21, 20, None, 22, 23],
    "Date": ["01-01-2025", "02/01/2025", "01-01-2025",
             "03-01-2025", None, "05/01/2025"]
}

df = pd.DataFrame(data)

print("----- RAW DATA -----")
print(df)

# 1. Clean column names
df.columns = df.columns.str.strip().str.lower().str.replace(" ", "_")

# 2. Remove duplicate rows
df = df.drop_duplicates()

# 3. Standardize Gender
df["gender"] = df["gender"].str.strip().str.lower()
df["gender"] = df["gender"].replace({
    "male": "Male",
    "female": "Female"
})

# 4. Standardize Country
df["country"] = df["country"].str.strip().str.title()

# 5. Fill missing Age with average age
df["age"] = df["age"].fillna(df["age"].mean()).round().astype(int)

# 6. Convert Date into consistent format
df["date"] = pd.to_datetime(df["date"], dayfirst=True, errors="coerce")
df["date"] = df["date"].dt.strftime("%d-%m-%Y")

# 7. Fill missing Gender
df["gender"] = df["gender"].fillna("Unknown")

# 8. Save cleaned dataset
df.to_csv("cleaned_dataset.csv", index=False)

print("\n----- CLEANED DATA -----")
print(df)

print("\n----- SUMMARY OF CHANGES -----")
print("✓ Column names cleaned")
print("✓ Duplicate rows removed")
print("✓ Gender values standardized")
print("✓ Country names standardized")
print("✓ Missing Age values filled")
print("✓ Date format standardized")
print("✓ Missing Gender handled")
print("\nCleaned dataset saved as: cleaned_dataset.csv")